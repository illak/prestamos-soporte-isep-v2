# ===========================================
# Variables de entorno para el Sistema de Préstamos ISEP
# ===========================================
# Copia este archivo como .env y configura los valores

# ----- Backend -----
NODE_ENV=production
DB_PATH=/app/data/prestamos.db

# ----- Bot de Telegram -----
# Token del bot (obtener de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# IDs de usuarios autorizados para usar el bot (separados por coma)
# Para obtener tu ID, envía un mensaje a @userinfobot en Telegram
TELEGRAM_ALLOWED_IDS=123456789,987654321

# ID del canal/grupo para notificaciones (opcional)
# Para grupos, el ID es negativo, ej: -1001234567890
TELEGRAM_ALERT_CHANNEL_ID=

# URL de la API (para el bot cuando se ejecuta en Docker)
API_BASE_URL=http://app:3000/api

# ----- Configuración de Alertas -----
# Días para considerar un préstamo como crítico
DIAS_CRITICOS=3

# Habilitar notificaciones automáticas
NOTIFICACIONES_ACTIVAS=false

# Hora para enviar resumen diario (formato 24h)
HORA_RESUMEN_DIARIO=08:00
